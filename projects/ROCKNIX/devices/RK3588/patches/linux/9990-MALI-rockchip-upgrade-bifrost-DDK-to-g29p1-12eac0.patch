+		u64 __timeout_us = (timeout_us);                                              \
+		unsigned long __delay_us = (delay_us);                                        \
+		ktime_t __timeout = ktime_add_us(ktime_get(), __timeout_us);                  \
+		if (delay_before_read && __delay_us)                                          \
+			udelay(__delay_us);                                                   \
+		for (;;) {                                                                    \
+			(val) = op(args);                                                     \
+			if (cond)                                                             \
+				break;                                                        \
+			if (__timeout_us && ktime_compare(ktime_get(), __timeout) > 0) {      \
+				(val) = op(args);                                             \
+				break;                                                        \
+			}                                                                     \
+			if (__delay_us)                                                       \
+				udelay(__delay_us);                                           \
+		}                                                                             \
+		(cond) ? 0 : -ETIMEDOUT;                                                      \
+	})
+
