+		if (atomic_read(&kbdev->csf.scheduler.gpu_idle_timer_enabled) &&
+		    atomic_read(&kbdev->csf.scheduler.fw_soi_enabled)) {
+			if (unlikely(!db_notif_disabled))
+				goto pend_soi_sleep;
+			backend->mcu_state = KBASE_MCU_ON_PEND_SLEEP;
+			return;
+		}
