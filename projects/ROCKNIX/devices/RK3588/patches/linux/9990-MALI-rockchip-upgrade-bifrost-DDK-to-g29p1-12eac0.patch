+++ b/Documentation/devicetree/bindings/arm/arm,coresight-mali-source.yaml	2026-10-21 21:57:10.654395621 -0400
@@ -0,0 +1,163 @@
+# SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+#
