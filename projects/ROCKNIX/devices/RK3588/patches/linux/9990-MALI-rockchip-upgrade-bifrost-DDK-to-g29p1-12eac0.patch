+	kunmap_pgd(phys_to_page(parent_pgd), parent_pgd_page);
+pgd_page_map_error:
+get_pgd_at_level_error:
+	kunmap_pgd(phys_to_page(new_pgd_phys), new_pgd_page);
+new_page_map_error:
+	kunmap_pgd(phys_to_page(old_pgd_phys), old_pgd_page);
+old_page_map_error:
+	return ret;
+}
