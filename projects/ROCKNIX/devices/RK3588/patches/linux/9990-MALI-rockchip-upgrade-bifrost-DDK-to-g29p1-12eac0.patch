diff -ruN a/include/linux/memory_group_manager_for_bifrost.h b/include/linux/memory_group_manager_for_bifrost.h
--- a/include/linux/memory_group_manager_for_bifrost.h	1969-12-31 19:00:00.000000000 -0500
+++ b/include/linux/memory_group_manager_for_bifrost.h	2026-10-21 21:57:11.225441801 -0400
@@ -0,0 +1,226 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
