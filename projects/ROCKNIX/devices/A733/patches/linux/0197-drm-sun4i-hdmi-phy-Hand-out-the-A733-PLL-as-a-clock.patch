 drivers/gpu/drm/sun4i/sun8i_hdmi_phy.c     | 182 ++-------------
 drivers/gpu/drm/sun4i/sun8i_hdmi_phy_clk.c | 244 ++++++++++++++++++++-
 3 files changed, 292 insertions(+), 167 deletions(-)

