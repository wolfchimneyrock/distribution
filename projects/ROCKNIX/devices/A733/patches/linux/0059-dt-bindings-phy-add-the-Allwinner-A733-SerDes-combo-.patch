From af44b7db7124e3513fe6dc05dbf85f91996c50d0 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 3 Sep 2026 07:01:32 +0200
Subject: [PATCH 059/211] dt-bindings: phy: add the Allwinner A733 SerDes combo
 PHY

The A733 SerDes subsystem contains two Cadence combo PHYs behind an
Allwinner wrapper. Describe the second one, which serves the PCIe
controller.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 .../phy/allwinner,sun60i-a733-combophy.yaml   | 82 +++++++++++++++++++
 1 file changed, 82 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-combophy.yaml

diff --git a/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-combophy.yaml b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-combophy.yaml
new file mode 100644
index 00000000000..0c969e5c675
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-combophy.yaml
@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/allwinner,sun60i-a733-combophy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 SerDes combo PHY
+
+maintainers:
+  - Jernej Skrabec <jernej.skrabec@gmail.com>
+
+description:
+  The A733 SerDes subsystem contains two Cadence combo PHYs behind an
+  Allwinner wrapper. The second one serves either the USB3 controller or
+  the PCIe controller, only the PCIe use is described so far.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-combophy
+
+  reg:
+    items:
+      - description: Wrapper registers of the PHY
+      - description: Cadence PHY registers
+      - description: Lane routing registers of the SerDes subsystem
+
+  reg-names:
+    items:
+      - const: top
+      - const: phy
+      - const: pipe
+
+  clocks:
+    items:
+      - description: PHY configuration clock
+      - description: PHY reference clock
+
+  clock-names:
+    items:
+      - const: cfg
+      - const: ref
+
+  power-domains:
+    maxItems: 1
+
+  allwinner,serdes:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The SerDes subsystem clock controller, for its syscon
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - allwinner,serdes
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun60i-a733-ccu.h>
+    #include <dt-bindings/clock/sun6i-rtc.h>
+
+    phy@6c02000 {
+        compatible = "allwinner,sun60i-a733-combophy";
+        reg = <0x06c02000 0xa00>,
+              <0x06ca0000 0x20000>,
+              <0x06c06000 0x2000>;
+        reg-names = "top", "phy", "pipe";
+        clocks = <&ccu CLK_SERDES_PHY>, <&rtc CLK_HOSC_SERDES1>;
+        clock-names = "cfg", "ref";
+        allwinner,serdes = <&serdes_ccu>;
+        power-domains = <&pck600 7>;
+        #phy-cells = <0>;
+    };
+
+...
-- 
