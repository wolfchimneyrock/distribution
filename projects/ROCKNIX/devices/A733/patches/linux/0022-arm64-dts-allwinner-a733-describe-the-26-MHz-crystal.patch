From e57ef07d16a80e45f6827cd909b936601a6d1324 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Wed, 2 Sep 2026 11:16:19 +0200
Subject: [PATCH 022/211] arm64: dts: allwinner: a733: describe the 26 MHz
 crystal

The oscillator on the board runs at 26 MHz; PLL_REF turns it into the
24 MHz that the rest of the clock tree calls sys-24M. Calling the crystal
24 MHz makes every clock below sys-24M come out at 12/13 of its real rate,
which is enough to turn the console to noise as soon as the 8250 driver
takes the port over from earlycon.

Give the pin controller the normalised reference it actually wants, rather
than the crystal.
---
 arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 3721aa9e857..95346179a0b 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -78,11 +78,11 @@ cpu7: cpu@700 {
 		};
 	};
 
-	osc24M: osc24M-clk {
+	osc26M: osc26M-clk {
 		#clock-cells = <0>;
 		compatible = "fixed-clock";
-		clock-frequency = <24000000>;
-		clock-output-names = "osc24M";
+		clock-frequency = <26000000>;
+		clock-output-names = "osc26M";
 	};
 
 	osc32k: osc32k-clk {
@@ -133,7 +133,7 @@ pio: pinctrl@2000000 {
 				     <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 87 IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&ccu CLK_APB1>, <&osc24M>, <&osc32k>;
+			clocks = <&ccu CLK_APB1>, <&ccu CLK_SYS_24M>, <&osc32k>;
 			clock-names = "apb", "hosc", "losc";
 			gpio-controller;
 			#gpio-cells = <3>;
@@ -152,7 +152,7 @@ mmc0_pins: mmc0-pins {
 		ccu: clock-controller@2002000 {
 			compatible = "allwinner,sun60i-a733-ccu";
 			reg = <0x02002000 0x2000>;
-			clocks = <&osc24M>, <&osc32k>, <&iosc>;
+			clocks = <&osc26M>, <&osc32k>, <&iosc>;
 			clock-names = "hosc", "losc", "iosc";
 			#clock-cells = <1>;
 			#reset-cells = <1>;
-- 
