From 47ea41dc9aa35804e9b1f4391e7820c291c17215 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 3 Sep 2026 07:01:32 +0200
Subject: [PATCH 063/211] arm64: dts: allwinner: a733: add the PCIe controller
 and its PHY

Describe the single lane PCIe controller together with the second combo
PHY of the SerDes subsystem that it uses. The INTx interrupts come out
of the controller's system information interrupt, hence the nested
interrupt controller.

The master port is 32 bit, so restrict the DMA window to the first
memory bank. Without that a device is handed addresses above 4 GB and
its transfers land somewhere else.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 .../arm64/boot/dts/allwinner/sun60i-a733.dtsi | 65 ++++++++++++++++++-
 1 file changed, 63 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 986c17dd7dc..bd3f5126bf3 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -759,9 +759,56 @@ dwc3: usb@6a00000 {
 			};
 		};
 
+		pcie: pcie@6000000 {
+			compatible = "allwinner,sun60i-a733-pcie";
+			reg = <0x06000000 0x400000>,
+			      <0x06400000 0x2000>,
+			      <0x20000000 0x1000000>;
+			reg-names = "dbi", "app", "config";
+			interrupts = <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "msi";
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &pcie_intc 0>,
+					<0 0 0 2 &pcie_intc 1>,
+					<0 0 0 3 &pcie_intc 2>,
+					<0 0 0 4 &pcie_intc 3>;
+			clocks = <&serdes_ccu CLK_SERDES_PCIE>,
+				 <&ccu CLK_PCIE_AUX>,
+				 <&ccu CLK_PCIE_AXI_SLV>,
+				 <&ccu CLK_BUS_ITS_PCIE0_ACLK>;
+			clock-names = "dbi", "aux", "slv", "its";
+			resets = <&ccu RST_BUS_PCIE>,
+				 <&ccu RST_BUS_PCIE_PWRUP>,
+				 <&ccu RST_BUS_ITS_PCIE0>;
+			reset-names = "core", "pwr", "its";
+			phys = <&combophy1>;
+			phy-names = "pcie-phy";
+			power-domains = <&pck600 PD_PCIE>;
+			device_type = "pci";
+			bus-range = <0x0 0xff>;
+			num-lanes = <1>;
+			max-link-speed = <3>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x81000000 0 0x00000000 0x21000000 0 0x00100000>,
+				 <0x82000000 0 0x22000000 0x22000000 0 0x06000000>;
+			/* The master port reaches only the first 4 GiB */
+			dma-ranges = <0x02000000 0 0x40000000 0x40000000 0 0xc0000000>;
+			status = "disabled";
+
+			pcie_intc: legacy-interrupt-controller {
+				interrupt-controller;
+				#address-cells = <0>;
+				#interrupt-cells = <1>;
+				interrupt-parent = <&gic>;
+				interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>;
+			};
+		};
+
 		serdes_ccu: clock-controller@6c00000 {
-			compatible = "allwinner,sun60i-a733-serdes-ccu";
-			reg = <0x06c00000 0x1000>;
+			compatible = "allwinner,sun60i-a733-serdes-ccu", "syscon";
+			reg = <0x06c00000 0x400>;
 			clocks = <&ccu CLK_AHB_SERDES>,
 				 <&ccu CLK_MBUS_SERDES>,
 				 <&ccu CLK_SERDES_PHY>,
@@ -772,6 +819,20 @@ serdes_ccu: clock-controller@6c00000 {
 			#reset-cells = <1>;
 		};
 
+		combophy1: phy@6c02000 {
+			compatible = "allwinner,sun60i-a733-combophy";
+			reg = <0x06c02000 0xa00>,
+			      <0x06ca0000 0x20000>,
+			      <0x06c06000 0x2000>;
+			reg-names = "top", "phy", "pipe";
+			clocks = <&ccu CLK_SERDES_PHY>, <&rtc CLK_HOSC_SERDES1>;
+			clock-names = "cfg", "ref";
+			allwinner,serdes = <&serdes_ccu>;
+			power-domains = <&pck600 PD_PCIE>;
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
 		r_ccu: clock-controller@7010000 {
 			compatible = "allwinner,sun60i-a733-r-ccu";
 			reg = <0x07010000 0x250>;
-- 
