From 4a3a4f4e45aa5817aea4ac3229cb7712cf7a4504 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Fri, 4 Sep 2026 11:44:05 +0200
Subject: [PATCH 089/211] arm64: dts: allwinner: a733: slow the CPUs down when
 they get hot

Give the two cluster sensors trip points and let them lower the CPU
frequency, and describe the other three so their readings are available.

The board has no fan and no heatsink, and a load on all eight cores
reaches 90 degrees in under a minute, so without this the only thing
standing between a build and a reset is an artificial frequency cap.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 .../arm64/boot/dts/allwinner/sun60i-a733.dtsi | 99 +++++++++++++++++++
 1 file changed, 99 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index f6f0eb04489..859aa8fe5f8 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: (GPL-2.0-only OR MIT)
 
 #include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/thermal/thermal.h>
 #include <dt-bindings/clock/sun6i-rtc.h>
 #include <dt-bindings/clock/sun60i-a733-ccu.h>
 #include <dt-bindings/clock/sun60i-a733-cpu-ccu.h>
@@ -27,6 +28,7 @@ cpu0: cpu@0 {
 			enable-method = "psci";
 			clocks = <&cpu_ccu CLK_CPU_L>;
 			capacity-dmips-mhz = <530>;
+			#cooling-cells = <2>;
 		};
 
 		cpu1: cpu@100 {
@@ -81,6 +83,7 @@ cpu6: cpu@600 {
 			enable-method = "psci";
 			clocks = <&cpu_ccu CLK_CPU_B>;
 			capacity-dmips-mhz = <1024>;
+			#cooling-cells = <2>;
 		};
 
 		cpu7: cpu@700 {
@@ -1027,4 +1030,100 @@ cpu_ccu: clock-controller@8870000 {
 			assigned-clock-rates = <780000000>;
 		};
 	};
+
+	thermal-zones {
+		cpub-thermal {
+			polling-delay-passive = <500>;
+			polling-delay = <1000>;
+			thermal-sensors = <&ths 0>;
+
+			trips {
+				cpub_hot: cpu-hot {
+					temperature = <70000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				cpub_very_hot: cpu-very-hot {
+					temperature = <90000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				cpu-critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpub_hot>;
+					cooling-device = <&cpu6 THERMAL_NO_LIMIT 2>;
+				};
+
+				map1 {
+					trip = <&cpub_very_hot>;
+					cooling-device = <&cpu6 3 THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+
+		ddr-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&ths 1>;
+		};
+
+		npu-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&ths 2>;
+		};
+
+		cpul-thermal {
+			polling-delay-passive = <500>;
+			polling-delay = <1000>;
+			thermal-sensors = <&ths 3>;
+
+			trips {
+				cpul_hot: cpu-hot {
+					temperature = <70000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				cpul_very_hot: cpu-very-hot {
+					temperature = <90000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				cpu-critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpul_hot>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT 2>;
+				};
+
+				map1 {
+					trip = <&cpul_very_hot>;
+					cooling-device = <&cpu0 3 THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+
+		gpu-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&ths 4>;
+		};
+	};
 };
-- 
