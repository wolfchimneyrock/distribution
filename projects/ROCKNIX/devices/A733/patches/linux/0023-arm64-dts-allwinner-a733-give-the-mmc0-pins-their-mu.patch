From ce4f67b23cd43a623e4679b4304ddce9580cd3f3 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Wed, 2 Sep 2026 11:30:18 +0200
Subject: [PATCH 023/211] arm64: dts: allwinner: a733: give the mmc0 pins their
 mux value

The pin controller builds its function table from the device tree, so a
group has to say which mux value the function lives on. Without it the
card's pins are refused and mmc0 is left with whatever the boot loader
configured.
---
 arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 95346179a0b..9b90eaae133 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -143,6 +143,7 @@ pio: pinctrl@2000000 {
 			mmc0_pins: mmc0-pins {
 				pins = "PF0", "PF1", "PF2",
 				       "PF3", "PF4", "PF5";
+				allwinner,pinmux = <2>;
 				function = "mmc0";
 				drive-strength = <30>;
 				bias-pull-up;
-- 
2.30.2

