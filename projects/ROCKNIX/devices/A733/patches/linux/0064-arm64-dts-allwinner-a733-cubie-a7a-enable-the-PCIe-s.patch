From 416c6cee6ec1417c07675695223f6b867d6847bd Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 3 Sep 2026 07:01:33 +0200
Subject: [PATCH 064/211] arm64: dts: allwinner: a733: cubie-a7a: enable the
 PCIe slot

The board routes the lane to an M.2 socket. Its 3.3 V rail is switched
by PE11 and is left for the controller to turn on as part of the reset
sequence, PERST# is PE13, and CLKREQ# and WAKE# sit on the dedicated pin
functions of PE14 and PE12.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 .../dts/allwinner/sun60i-a733-cubie-a7a.dts   | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
index b5f45cb96bb..3b2471b07c8 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -82,6 +82,16 @@ reg_wifi_en: wifi-en {
 		regulator-always-on;
 	};
 
+	reg_pcie_3v3: pcie-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "pcie-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&reg_dcdc1>;
+		gpio = <&pio 4 11 GPIO_ACTIVE_HIGH>; /* PE11 */
+		enable-active-high;
+	};
+
 	reg_ldo2v5: ldo2v5 {
 		/* SY8089A buck feeding the PMIC BLDO and CLDO groups */
 		compatible = "regulator-fixed";
@@ -158,6 +168,10 @@ &mmc2 {
 	status = "okay";
 };
 
+&combophy1 {
+	status = "okay";
+};
+
 &ohci0 {
 	status = "okay";
 };
@@ -166,6 +180,14 @@ &ohci1 {
 	status = "okay";
 };
 
+&pcie {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie_pe_pins>;
+	reset-gpios = <&pio 4 13 GPIO_ACTIVE_LOW>; /* PE13 */
+	vpcie3v3-supply = <&reg_pcie_3v3>;
+	status = "okay";
+};
+
 &pio {
 	vcc-pb-supply = <&reg_swout2>;	/* via VCC-IO */
 	vcc-pc-supply = <&reg_cldo5>;
@@ -183,6 +205,12 @@ i2c0_pg8_pg9_pins: i2c0-pg8-pg9-pins {
 		function = "i2c0";
 	};
 
+	pcie_pe_pins: pcie-pe-pins {
+		pins = "PE12", "PE14";
+		allwinner,pinmux = <6>;
+		function = "pcie";
+	};
+
 	rgmii0_pins: rgmii0-pins {
 		pins = "PH0", "PH1", "PH2", "PH4", "PH5", "PH6",
 		       "PH7", "PH8", "PH9", "PH10", "PH11", "PH12",
-- 
