From 7b57fab2f3c5486b327df23a3665edd108bab708 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 3 Sep 2026 08:44:19 +0200
Subject: [PATCH 068/211] arm64: dts: allwinner: a733: cubie-a7a: enable the
 GPU

The GPU is powered from DCDC4 of the PMIC. The power controller has no way
to name a supply for its domains yet, so keep the regulator on; otherwise
it is switched off as unused before the GPU probes.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
index 3b2471b07c8..3f3338bf793 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -123,6 +123,10 @@ &gmac0 {
 	status = "okay";
 };
 
+&gpu {
+	status = "okay";
+};
+
 &i2c0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c0_pg8_pg9_pins>;
@@ -280,6 +284,8 @@ reg_dcdc3: dcdc3 {
 			};
 
 			reg_dcdc4: dcdc4 {
+				/* The GPU power domains have no supply hook yet */
+				regulator-always-on;
 				regulator-min-microvolt = <800000>;
 				regulator-max-microvolt = <960000>;
 				regulator-name = "vdd-gpu";
-- 
2.30.2

