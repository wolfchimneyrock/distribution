# The GPU sits under /soc on mainline and at the top level on the vendor kernel.
# Detect it by its platform device, which exists before a GPU driver loads.
GPU_DEV="/sys/devices/platform/soc/27800000.gpu"
[ -d "${GPU_DEV}" ] || GPU_DEV="/sys/devices/platform/27800000.gpu"

cat <<EOT >/storage/.config/profile.d/010-governors
CPU_FREQ=("/sys/devices/system/cpu/cpufreq/policy0" "/sys/devices/system/cpu/cpufreq/policy4")
GPU_FREQ=("${GPU_DEV}/devfreq/27800000.gpu")
EOT
